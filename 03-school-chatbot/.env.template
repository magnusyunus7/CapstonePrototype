# ==========================================================================
# Project identity — used to name the containers (e.g. school-chatbot-db)
# ==========================================================================
PROJECT_NAME='school-chatbot'
COMPOSE_PROJECT_NAME=${PROJECT_NAME}

# Port you open in the browser -> http://localhost:8080
WEBUI_PORT=8080

# ==========================================================================
# Postgres — stores users, chats, settings
# ==========================================================================
POSTGRES_DB='school-chatbot'
POSTGRES_USER='school-chatbot'
POSTGRES_PASSWORD='change-me'
POSTGRES_HOST=${PROJECT_NAME}-db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
PGDATA=/var/lib/postgresql/18/data

# ==========================================================================
# Vector DB (Qdrant) — powers document search / RAG
# ==========================================================================
VECTOR_DB=qdrant
QDRANT_URI=http://${PROJECT_NAME}-qdrant:6333
# QDRANT_API_KEY=            # optional, set to protect the Qdrant API

# ==========================================================================
# Model provider — pick ONE (or both). This is what the chatbot talks to.
# --------------------------------------------------------------------------
# Option A: Hosted OpenAI-compatible API (OpenAI, Groq, OpenRouter, etc.)
#   OPENAI_API_BASE_URL defaults to OpenAI; change it for other providers.
# ==========================================================================
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-key-here

# --------------------------------------------------------------------------
# Option B: Local models via Ollama (leave empty if not using Ollama)
# --------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==========================================================================
# AI SWAPPABLE MODEL LAYER (recommended)
# --------------------------------------------------------------------------
# Chat-completions call surface used by all 3 stages (Generator, Validator,
# Orchestrator). Supports 2 providers; modifying these 4 lines is the ONLY
# thing needed to swap to a new model - no code change required.
#
#   AI_PROVIDER    "ollama" (local /api/chat above) OR
#                  "openai_compat" (LiteLLM/OpenRouter/vLLM/corporate proxy
#                  with /v1/chat/completions).
#   AI_BASE_URL    override chat-completions base URL (falls back to
#                  OLLAMA_BASE_URL if unset). For openai_compat, point at
#                  `.../v1`.
#   AI_API_KEY     bearer token for openai_compat; unused for ollama.
#   AI_MODEL       chat model tag (overrides OLLAMA_MODEL if set).
#
# Examples:
#   AI_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   AI_MODEL=llama3.1:8b
# ---
#   AI_PROVIDER=openai_compat
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
# ==========================================================================
# AI_PROVIDER=ollama
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# ==========================================================================
# App security / behavior
# ==========================================================================
WEBUI_SECRET_KEY='change-me-to-something-random'
ENABLE_SIGNUP=true          # first account created becomes the admin
DEFAULT_USER_ROLE=pending   # new users wait for admin approval

PYTHONUNBUFFERED=1
